<!-- This file is app/views/movies/index.html.erb -->
<p style="color: green"><%= notice %></p>

<h1>Movies</h1>

<%# Part 1: Filter movies by rating %>
<%# Part 2: Sort movies by title or release date %>
<%# Part 3: Remember sorting and filtering settings %>
<%= form_tag movies_path, method: :get, id: 'ratings_form', local: true do %>
  <%= hidden_field_tag :home, '1' %>

  Include:
  <% @all_ratings.each do |rating| %>
    <div class="form-check form-check-inline">
      <%= check_box_tag "ratings[#{rating}]", "1",
          @ratings_to_show.include?(rating),
          id: "ratings_#{rating}",
          class: 'form-check-input' %>

      <%= label_tag "ratings_#{rating}", rating,
          class: 'form-check-label' %>
    </div>
  <% end %>

  <div>
    <label class="form-label me-2" for="sort_by">Sort by:</label>
    <%= select_tag :sort_by,
                   options_for_select([["Title", "title"],
                                       ["Release Date", "release_date"]],
                                       @sort_by),
                   id: "sort_by",
                   class: "form-select d-inline w-auto" %>
  </div>

  <%= submit_tag 'Refresh',
      id: 'ratings_submit',
      class: 'btn btn-primary' %>
<% end %>

<%# Movie table with clickable sorting headers %>
<table id="movies" class="table table-striped">
  <thead>
    <tr>
      <th>
        <%= link_to "Title",
            movies_path(
              sort_by: "title",
              ratings: @ratings_to_show.index_with { '1' },
              home: 1
            ) %>
      </th>

      <th>Rating</th>
      <th>Description</th>

      <th>
        <%= link_to "Release Date",
            movies_path(
              sort_by: "release_date",
              ratings: @ratings_to_show.index_with { '1' },
              home: 1
            ) %>
      </th>

      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.description %></td>
        <td><%= movie.release_date %></td>
        <td><%= link_to "Show this movie", movie %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New movie", new_movie_path %>